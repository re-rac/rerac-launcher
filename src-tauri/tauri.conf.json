{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReRAC Launcher",
  "mainBinaryName": "rerac-launcher",
  "version": "../package.json",
  "identifier": "com.rerac.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReRAC Launcher",
        "width": 1180,
        "height": 740,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0f1c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "macOS": {
      "signingIdentity": "-"
    },
    "copyright": "Copyright (c) 2026 ReRAC contributors",
    "license": "ISC",
    "shortDescription": "Launcher for ReRAC",
    "longDescription": "ReRAC is a native rewrite of the PlayStation 2 game Ratchet & Clank (2002). The launcher installs the game data once from your own disc image, manages game versions and starts the game.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
